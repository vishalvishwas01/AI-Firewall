# Server and web application URLs embedded at extension build time.
PLASMO_PUBLIC_API_BASE_URL=http://localhost:4000
PLASMO_PUBLIC_CLIENT_BASE_URL=http://localhost:5173

# JSON object of reviewed Ed25519 root public keys encoded with base64url.
# An empty value safely disables remote intelligence refresh; bundled local
# protection continues to work. Never place private signing keys here.
PLASMO_PUBLIC_INTELLIGENCE_ROOT_KEYS=
