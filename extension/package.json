{
  "name": "hallguard",
  "displayName": "HallGuard",
  "version": "0.1.0",
  "description": "HallGuard is a local-first AI permission firewall that warns before risky prompts, uploads, and scam-like content.",
  "author": "HallGuard",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run --environment node",
    "benchmark:report": "vitest run --environment node src/firewall/benchmarkReport.cli.test.ts --reporter=verbose",
    "benchmark:shadow": "vitest run --environment node src/features/detection/shadowReport.cli.test.ts src/features/detection/shadowPerformance.test.ts --reporter=verbose --poolOptions.threads.singleThread=true",
    "intelligence:drill": "vitest run --environment node src/features/intelligence/deploymentDrill.test.ts --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "lucide-react": "^0.468.0",
    "plasmo": "^0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.10",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "http://localhost:4000/*",
      "http://127.0.0.1:4000/*"
    ],
    "externally_connectable": {
      "matches": [
        "https://hallguard.in/*",
        "https://www.hallguard.in/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ]
    },
    "permissions": [
      "alarms",
      "tabs",
      "storage"
    ]
  }
}
