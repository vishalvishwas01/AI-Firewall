# The ML workspace is an offline CLI/tooling workspace, not a network service.
# These settings help local source resolution and reproducible Python behavior;
# commands still use their reviewed CLI arguments and fixed contract seed.
PYTHONPATH=src
PYTHONUTF8=1
PYTHONHASHSEED=20260801

# Intentionally no PORT, server URL, database credential, signing private key,
# telemetry source, customer-data source, or AI provider key belongs here.
