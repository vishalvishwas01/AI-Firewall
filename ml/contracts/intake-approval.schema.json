{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallguard.local/contracts/hallguard-b2-intake-approval-v1.schema.json",
  "title": "HallGuard B2 Controlled Intake Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packageVersion", "reviewType", "reviewedOn", "status",
    "releaseEligible", "evidenceProvenance", "operationalPolicy", "reviewers", "sources", "gates",
    "nextStep"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageVersion": { "const": "b2-intake-approval-v1" },
    "reviewType": { "const": "HUMAN_APPROVAL" },
    "reviewedOn": { "type": "string", "format": "date" },
    "status": { "const": "approved-for-controlled-intake-with-conditions" },
    "releaseEligible": { "const": false },
    "evidenceProvenance": { "const": "reviewer-decisions-relayed-by-user" },
    "operationalPolicy": { "type": "object" },
    "reviewers": { "type": "array", "minItems": 3, "maxItems": 3 },
    "sources": { "type": "array", "minItems": 3, "maxItems": 3 },
    "gates": { "type": "object" },
    "nextStep": { "const": "controlled-source-pinning-and-quarantine" }
  }
}
