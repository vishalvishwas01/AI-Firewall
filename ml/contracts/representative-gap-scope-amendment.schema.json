{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallguard.local/contracts/hallguard-m3-representative-gap-scope-amendment-v1.schema.json",
  "title": "HallGuard M3 Representative Gap Scope Amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "amendmentVersion", "reviewType", "reviewedOn", "status",
    "analysisVersion", "scope", "reviewers", "authorization", "gates", "nextStep"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "amendmentVersion": {"const": "m3-representative-gap-scope-amendment-v1"},
    "reviewType": {"const": "HUMAN_APPROVAL"},
    "reviewedOn": {"type": "string", "format": "date"},
    "status": {"const": "approved-selector-scope-awaiting-network-authorization"},
    "analysisVersion": {"const": "m3-representative-gap-analysis-v1"},
    "nextStep": {"const": "m3-request-one-time-exact-pin-network-authorization"}
  }
}
