# Runtime
NODE_ENV=development
PORT=4000

# Persistence
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_firewall

# Authentication. Replace this placeholder with a long random value.
JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Allowed web and extension origins. EXTENSION_ORIGIN is assigned by Chrome
# after loading/building the extension, for example chrome-extension://<id>.
CLIENT_ORIGIN=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://replace-with-extension-id

# Signed intelligence publication. Keep disabled until reviewed publisher
# identities and external signing custody are provisioned. Never put a private
# signing key in this file or in the server.
INTELLIGENCE_PUBLISHER_EMAILS=security-publisher@example.com
INTELLIGENCE_AUDIT_RETENTION_DAYS=730
INTELLIGENCE_SIGNER_MODE=disabled

# Transactional email for organization invitations
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=HallGuard <noreply@example.com>
