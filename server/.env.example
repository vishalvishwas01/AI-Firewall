# Runtime
NODE_ENV=development
PORT=4000
# Keep false in normal operation. When true, only manual POST /auth/signup bypasses
# the authentication rate limiter; global and OTP protections remain active.
DISABLE_MANUAL_SIGNUP_RATE_LIMITING=true
# Set this to the exact number of trusted reverse-proxy hops in front of Express.
# Keep 0 locally/direct, use 1 for Render alone, and verify the forwarded chain
# before using 2 for a Cloudflare -> Render -> Express deployment.
TRUST_PROXY_HOPS=0
# Login security history is stored separately and automatically expires.
LOGIN_ACTIVITY_RETENTION_DAYS=180
# Optional IP-to-city lookup through ipwho.is. Keep false if external lookup is not desired.
LOGIN_GEOLOCATION_ENABLED=false

# Persistence
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_firewall
# Upstash Redis REST credentials. Admin help-desk reply drafts are cached here for 30 days.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Authentication. Replace this placeholder with a long random value.
JWT_SECRET=replace-with-at-least-32-random-characters
# New tokens are signed with this key ID and secret. Rotate these on the short cadence you choose.
JWT_ACTIVE_KEY_ID=primary-2026-08
JWT_ACTIVE_SECRET=replace-with-another-at-least-32-character-random-secret
# Keep retired keys here until every token signed by them has expired, then remove them.
JWT_PREVIOUS_KEYS={"primary-2026-07":"replace-with-the-previous-at-least-32-character-secret"}
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Allowed web and extension origins. EXTENSION_ORIGIN is assigned by Chrome
# after loading/building the extension, for example chrome-extension://<id>.
CLIENT_ORIGIN=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://replace-with-extension-id

# Signed intelligence publication. Keep disabled until reviewed publisher
# identities and external signing custody are provisioned. Never put a private
# signing key in this file or in the server.
INTELLIGENCE_PUBLISHER_EMAILS=security-publisher@example.com
INTELLIGENCE_AUDIT_RETENTION_DAYS=730
INTELLIGENCE_SIGNER_MODE=disabled

# A8 local in-process signing/publication. Keep both disabled until a separate
# deployment review approves the key and staging workflow. Never commit a key.
A8_LOCAL_SIGNING_ENABLED=false
A8_LOCAL_PUBLICATION_ENABLED=false
A8_SIGNING_KEY_ID=hallguard-staging-v1
A8_SIGNING_PRIVATE_KEY_PEM=
A8_STAGING_OUTPUT_DIR=./artifacts/staging

# AI-assisted ML workflow. Disabled and manual-first until provider, model,
# privacy terms, budget approval, and isolated runner custody are reviewed.
# Never commit a real API key. Leave these blank until the provider is selected.
AI_ML_ENABLED=false
# Emergency kill switch: disables AI calls and automatic triggers only.
AI_ML_KILL_SWITCH_ENABLED=false
AI_PROVIDER_CONFIG_APPROVED=false
AI_PROVIDER=openrouter
AI_MODEL=nvidia/nemotron-3.5-lightning:free
AI_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_ML_AUTO_TRIGGER_ENABLED=false
AI_ML_MAX_RUNS_PER_DAY=1
AI_ML_MAX_ACTIVE_RUNS=1
AI_ML_COOLDOWN_SECONDS=86400
AI_ML_MAX_RUN_SECONDS=1800
AI_ML_MAX_DATASET_ROWS=100000
AI_ML_MAX_AI_TOKENS_PER_RUN=2048
AI_ML_MAX_AI_COST_USD_PER_RUN=0

# Transactional email. EMAIL_LOGO_URL must be a public HTTPS image URL in production.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=HallGuard <noreply@example.com>
EMAIL_LOGO_URL=https://example.com/hallguard-icon.png
