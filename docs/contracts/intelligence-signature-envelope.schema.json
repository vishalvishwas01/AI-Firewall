{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallguard.local/contracts/intelligence-signature-envelope-v1.schema.json",
  "title": "HallGuard Intelligence Detached Signature Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "algorithm",
    "keyId",
    "signatureEncoding",
    "domain",
    "payloadSha256",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "enum": ["package-manifest", "trust-bundle"] },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$" },
    "signatureEncoding": { "const": "base64url-no-pad" },
    "domain": {
      "enum": [
        "hallguard-intelligence-package-v1",
        "hallguard-intelligence-trust-bundle-v1"
      ]
    },
    "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}

